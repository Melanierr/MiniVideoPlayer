<Window x:Class="MiniVideoWidget.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mini Video Widget"
        Width="520"
        Height="360"
        MinWidth="340"
        MinHeight="240"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="White"
        WindowStartupLocation="CenterScreen">
	<Window.Resources>
		<Style TargetType="Button">
			<Setter Property="Background" Value="#343434"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Padding" Value="10,5"/>
			<Setter Property="Margin" Value="0,0,6,0"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="MinHeight" Value="28"/>
		</Style>
	</Window.Resources>
	<Border BorderBrush="#555555" BorderThickness="0">
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition x:Name="HeaderRow" Height="34"/>
				<RowDefinition Height="*"/>
				<RowDefinition x:Name="ControlsRow" Height="Auto"/>
			</Grid.RowDefinitions>
			<Grid x:Name="HeaderPanel"
                Grid.Row="0"
                Background="#262626"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>
				<TextBlock Text="MINI VIDEO PLAYER :fire:"
                           VerticalAlignment="Center"
                           Margin="12,0"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="#DDDDDD"/>
				<Button Grid.Column="1"
                        Content="—"
                        Width="32"
                        Click="Minimize_Click"/>
				<Button Grid.Column="2"
                        Content="✕"
                        Width="32"
                        Margin="0"
                        Background="#9D3030"
                        Click="Close_Click"/>
			</Grid>
			<Border Grid.Row="1"
                Background="Black"
                ClipToBounds="True"
                MouseLeftButtonDown="Video_MouseLeftButtonDown"
                MouseRightButtonUp="Video_MouseRightButtonUp">
				<MediaElement x:Name="Player"
                              LoadedBehavior="Manual"
                              UnloadedBehavior="Close"
                              Stretch="UniformToFill"
                              Volume="0.5"
                              MediaEnded="Player_MediaEnded"
                              MediaFailed="Player_MediaFailed"/>
			</Border>
			<StackPanel x:Name="ControlsPanel"
                        Grid.Row="2"
                        Background="#202020"
                        Margin="10">
				<TextBlock x:Name="FileLabel"
                           Text="No video selected"
                           FontSize="11"
                           Foreground="#AAAAAA"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,0,8"/>
				<WrapPanel Margin="0,0,0,8">
					<Button Content="open" Click="Open_Click"/>
					<Button Content="play" Click="Play_Click"/>
					<Button Content="pause" Click="Pause_Click"/>
					<Button Content="stop" Click="Stop_Click"/>
				</WrapPanel>
				<WrapPanel>
					<CheckBox x:Name="LoopCheck"
                              Content="Loop Video"
                              IsChecked="True"
                              VerticalAlignment="Center"
                              Margin="0,0,14,0"/>
					<CheckBox x:Name="TopmostCheck"
                              Content="Always On Top"
                              Checked="Topmost_Changed"
                              Unchecked="Topmost_Changed"
                              VerticalAlignment="Center"
                              Margin="0,0,14,0"/>
					<TextBlock Text="Volume"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>
					<Slider Minimum="0"
                            Maximum="100"
                            Value="50"
                            Width="90"
                            VerticalAlignment="Center"
                            ValueChanged="Volume_Changed"/>
				</WrapPanel>
			</StackPanel>
		</Grid>
	</Border>
</Window>
